{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "description": "Revision number of the quotation as sent by the agent"
    },
    "title": {
      "type": "string"
    },
    "region": {
      "type": "string"
    },
    "heroImage": {
      "type": "string"
    },
    "homeCity": {
      "type": "string"
    },
    "startDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "endDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "sentAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "validUntil": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "includes": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "travellers": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "initials": {
            "type": "string",
            "maxLength": 3
          },
          "type": {
            "default": "adult",
            "type": "string",
            "enum": [
              "adult",
              "child"
            ]
          }
        },
        "required": [
          "name",
          "initials"
        ]
      },
      "description": "The first traveller is the account holder"
    },
    "agent": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "possessive": {
          "type": "string",
          "description": "Possessive pronoun used in copy, e.g. \"her\""
        }
      },
      "required": [
        "name",
        "possessive"
      ]
    },
    "itinerary": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(seg|stop):.+$"
      },
      "description": "Order of segments and stops, e.g. \"seg:arr\", \"stop:kochi\""
    }
  },
  "required": [
    "id",
    "revision",
    "title",
    "region",
    "heroImage",
    "homeCity",
    "startDate",
    "endDate",
    "sentAt",
    "validUntil",
    "includes",
    "travellers",
    "agent",
    "itinerary"
  ]
}
