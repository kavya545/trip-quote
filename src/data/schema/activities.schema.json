{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "activities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "stop": {
            "type": "string",
            "minLength": 1
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "Planned date; add-ons can be moved to any day of their stop"
          },
          "name": {
            "type": "string"
          },
          "start": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
          },
          "end": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
          },
          "price": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Price for the whole group"
          },
          "included": {
            "default": false,
            "type": "boolean"
          },
          "credit": {
            "description": "Refund if an included activity is removed",
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "status": {
            "description": "Price status of an add-on",
            "type": "string",
            "enum": [
              "locked",
              "confirm"
            ]
          },
          "extra": {
            "type": "string"
          },
          "warn": {
            "type": "string"
          },
          "blurb": {
            "type": "string"
          },
          "images": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "stop",
          "date",
          "name",
          "start",
          "end",
          "price",
          "blurb",
          "images"
        ]
      }
    }
  },
  "required": [
    "activities"
  ]
}
