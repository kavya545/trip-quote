{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "stops": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string"
          },
          "image": {
            "type": "string"
          },
          "checkIn": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "checkOut": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "hotel",
              "houseboat"
            ]
          },
          "original": {
            "type": "object",
            "properties": {
              "hotel": {
                "type": "string",
                "minLength": 1
              },
              "room": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "hotel",
              "room"
            ],
            "description": "Hotel and room in the quotation as sent"
          },
          "dayTitles": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "One title per night, in order"
          },
          "hotels": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "name": {
                  "type": "string"
                },
                "image": {
                  "type": "string"
                },
                "meta": {
                  "type": "string"
                },
                "meals": {
                  "type": "string"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "locked",
                    "confirm"
                  ]
                },
                "blurb": {
                  "type": "string"
                },
                "features": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "rooms": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "name": {
                        "type": "string"
                      },
                      "rate": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991,
                        "description": "Price per room per night"
                      }
                    },
                    "required": [
                      "id",
                      "name",
                      "rate"
                    ]
                  }
                }
              },
              "required": [
                "id",
                "name",
                "image",
                "meta",
                "meals",
                "status",
                "blurb",
                "features",
                "rooms"
              ]
            }
          }
        },
        "required": [
          "id",
          "name",
          "image",
          "checkIn",
          "checkOut",
          "kind",
          "original",
          "dayTitles",
          "hotels"
        ]
      }
    }
  },
  "required": [
    "stops"
  ]
}
